# Copy to .env and adjust. Every value is optional; defaults are shown.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches the postgres service in docker-compose.yml (`docker compose up -d postgres`).
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
DB_POOL_MAX=10

# When set (min 16 chars), every /api/v1 request needs "Authorization: Bearer <API_KEY>".
# Leave empty to disable auth for local development.
API_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Number of reverse proxies in front of the app (so rate limiting sees the real client IP).
TRUST_PROXY=0
